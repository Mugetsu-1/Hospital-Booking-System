# Dependencies
node_modules/

# Build output
frontend/dist/
backend/coverage/

# Env & secrets (all .env variants; .env.example is tracked on purpose)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/

# AI-assistant local session state
.claude/

# Generated docx build artifacts (regenerated by `node docs/build-docx.mjs`)
docs/assets/
# Final Word artifact is generated locally from docs/LAB_REPORT.md and is
# intentionally not versioned. Submit the exported file separately if needed.
docs/LAB_REPORT.docx

# Local working note — full chat-session log, not part of the deliverable
CHAT_SESSION.md

# Root folder: keep only .json files, gitignore all others
# (package.json and package-lock.json are kept as project metadata)
# All other root-level files are excluded
!.gitignore
package.json
package-lock.json
* .md
* .json
!package.json
!package-lock.json
# Root non-json files excluded
/README\.md/
/.changelog/
/README\.md

# Docs folder: keep only .md and image files (*.webp, *.png, *.jpg, *.gif, *.svg)
/docs/build-docx\.mjs
/docs/capture-screenshots\.mjs
/docs/LAB_REPORT\.docx
/docs/package-lock\.json
/docs/package\.json

# Backend: keep only source files, gitignore env files and deps
/backend/.env
/backend/package-lock\.json
/backend/package\.json

# Frontend: keep only source files, gitignore env files and deps
/frontend/.env\.example
/frontend/package-lock\.json
/frontend/package\.json

# Screenshots: keep only images and readme
/screenshots/README\.md
