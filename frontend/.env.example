# Optional. Leave unset for local development: the Vite dev server proxies
# /api to http://localhost:5000 (see vite.config.js).
#
# Set this when the production bundle is served from a different origin than
# the API — e.g. the Vercel deployment talking to the Render backend:
# VITE_API_URL=https://hospital-booking-api.onrender.com/api
#
# Vite inlines VITE_* variables at build time, so add this in the Vercel
# project settings (Environment Variables) and redeploy after changing it.
# VITE_API_URL=/api
