{
  "name": "hospital-booking-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Hospital Doctor Appointment Booking System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "setup": "npm install",
    "postinstall": "prisma generate",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push && node scripts/db-setup.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/slots.test.js tests/slots.leave.test.js tests/transitions.test.js",
    "test:e2e": "node tests/e2e/api.e2e.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "7.10.0"
  }
}
