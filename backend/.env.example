PORT=5000

# ---- PostgreSQL (Render / Supabase / local) ----
# Local example:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hospital_booking?schema=public
#
# Supabase (Project Settings -> Database -> Connection string). Use the
# "Session pooler" or direct connection; append sslmode=require when it is
# not already part of the string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Render Postgres (internal URL when the API and DB are in the same region):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>

JWT_SECRET=change_me_dev_secret_please
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ---- Optional services (fail-open: the app runs fine without them) ----

# Redis cache for read-heavy endpoints. Leave empty to run without caching.
# Local example: REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# Nodemailer SMTP notifications. Set MAIL_ENABLED=true and provide a working
# SMTP server + MAIL_FROM to switch on booking confirmation e-mails.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cache TTL in seconds (applies when REDIS_URL is set)
CACHE_TTL_SECONDS=60
