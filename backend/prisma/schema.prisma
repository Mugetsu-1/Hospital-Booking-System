// PostgreSQL data model (Supabase / Render) for the Hospital Appointment
// Booking System. The connection string lives in prisma.config.ts
// (DATABASE_URL) — Prisma 7 no longer accepts `url` in the datasource block.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  patient
  doctor
  admin
}

enum ApptStatus {
  Pending
  Confirmed
  Completed
  Cancelled
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String   @map("password_hash")
  role             Role     @default(patient)
  age              Int?
  gender           String   @default("")
  phone            String   @default("")
  address          String   @default("")
  emergencyContact String   @default("") @map("emergency_contact")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  doctorProfile Doctor?
  appointments  Appointment[] @relation("PatientAppointments")

  @@map("users")
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String
  qualification   String   @default("")
  consultationFee Float    @map("consultation_fee")
  availableSlots  Json     @default("[]") @map("available_slots")
  isAvailable     Boolean  @default(true) @map("is_available")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("doctors")
}

model Appointment {
  id                String     @id @default(uuid())
  patientId         String     @map("patient_id")
  patient           User       @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String     @map("doctor_id")
  doctor            Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date              String
  startTime         String     @map("start_time")
  endTime           String     @map("end_time")
  dateTime          DateTime   @map("date_time")
  status            ApptStatus @default(Pending)
  symptoms          String     @default("")
  consultationNotes String     @default("") @map("consultation_notes")
  diagnosis         String     @default("")
  prescription      String     @default("")
  notesLastEditedAt DateTime?  @map("notes_last_edited_at")
  cancelledBy       String     @default("") @map("cancelled_by")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([doctorId, date, startTime])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}
